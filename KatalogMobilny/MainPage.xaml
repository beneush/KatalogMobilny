<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogMobilny.MainPage">
    <VerticalStackLayout Padding="16" x:Name="MainLayout">
        <Label Text="Procesor" FontSize="12" FontAttributes="Bold" 
               TextColor="#008BFF" HorizontalOptions="Center" Margin="0,20"/>
        <Image Source="procesor.jpg" Aspect="AspectFit" />
        <Label Text="Cena: 899 zł" TextColor="Gray" />
        
        <Label x:Name="EtykietaWyniku" Text="Nic nie wybrano" />
        <HorizontalStackLayout Spacing="10">
            <Button Text="Pokaż" Clicked="PokazClicked"/>
            <Button Text="Ukryj"/>
        </HorizontalStackLayout>
        
    </VerticalStackLayout>
